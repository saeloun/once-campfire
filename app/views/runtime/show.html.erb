<% @page_title = "Native Campfire · Runtime" %>
<% content_for :head do %>
<style>
  .rt-back { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 13px; font-weight: 600; text-decoration: none; border-radius: 8px; }
  .rt-back:hover { background: var(--color-selected); }
  .rt-back:focus-visible, .runtime summary:focus-visible { outline: 2px solid var(--color-link); outline-offset: 4px; }
  .runtime { --rt-accent: var(--color-link); --rt-muted: var(--dq-muted); --rt-line: var(--color-border); --rt-panel: var(--dq-surface); --rt-green: #28785a; --rt-cpu: #267e76; --rt-memory: #7154a1; --rt-latency: #986218; width: min(1344px, 100%); margin: 0 auto; padding: 24px 32px 64px; color: var(--color-text); }
  .runtime * { box-sizing: border-box; }
  .runtime header { display: flex; justify-content: space-between; gap: 24px; align-items: center; margin-bottom: 24px; }
  .runtime .rt-identity { display: flex; align-items: center; gap: 16px; }
  .runtime .rt-actions { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .runtime h1 { font-size: clamp(26px, 3vw, 34px); line-height: 1.15; letter-spacing: -.035em; margin: 4px 0 6px; text-wrap: balance; }
  .runtime h2 { font-size: 15px; margin: 0 0 16px; font-weight: 600; }
  .runtime p { margin: 0; }
  .runtime .rt-logo { width: 56px; height: 56px; border-radius: 12px; flex-shrink: 0; border: 1px solid var(--rt-line); }
  .runtime .rt-eyebrow { color: var(--rt-accent); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .runtime .rt-muted, .runtime small { color: var(--rt-muted); font-size: 12px; line-height: 1.6; }
  .runtime .rt-live { --rt-status: var(--rt-muted); display: inline-flex; align-items: center; border: 1px solid var(--rt-line); border-radius: 8px; padding: 10px 14px; font-size: 12px; font-weight: 600; white-space: nowrap; background: var(--rt-panel); }
  .runtime[data-state="live"] .rt-live { --rt-status: var(--rt-green); }
  .runtime[data-state="stale"] .rt-live, .runtime[data-state="unavailable"] .rt-live { --rt-status: var(--rt-latency); }
  .runtime .rt-live::before { content: ""; height: 7px; width: 7px; border-radius: 50%; margin-right: 8px; background: var(--rt-status); box-shadow: 0 0 0 4px color-mix(in srgb, var(--rt-status) 10%, transparent); }
  .runtime .rt-panel { border: 1px solid var(--rt-line); border-radius: 12px; background: var(--rt-panel); padding: 20px; min-width: 0; }
  .runtime .rt-proof { padding: 0; margin-bottom: 20px; }
  .runtime .rt-proof summary { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; min-height: 52px; padding: 12px 20px; cursor: pointer; font-size: 12px; list-style: none; }
  .runtime .rt-proof summary::-webkit-details-marker { display: none; }
  .runtime .rt-proof summary > strong { font-size: 12px; font-weight: 600; }
  .runtime .rt-proof summary > strong::before { content: "◇"; color: var(--rt-accent); margin-right: 8px; }
  .runtime .rt-proof summary > span { color: var(--rt-muted); }
  .runtime .rt-disclosure { margin-left: auto; }
  .runtime .rt-disclosure::after { content: " +"; color: var(--rt-accent); }
  .runtime details[open] .rt-disclosure::after { content: " −"; }
  .runtime .rt-proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding: 20px; border-top: 1px solid var(--rt-line); }
  .runtime .rt-proof-grid strong { display: block; margin: 4px 0 8px; font-size: 13px; }
  .runtime .rt-proof code { display: block; font-size: 11px; overflow-wrap: anywhere; color: var(--rt-muted); background: none; border: 0; padding: 0; }
  .runtime .rt-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
  .runtime .rt-cards .rt-panel { border-top: 2px solid color-mix(in srgb, var(--rt-accent) 55%, var(--rt-line)); }
  .runtime .rt-value { display: block; font-size: clamp(28px, 3vw, 36px); font-weight: 650; letter-spacing: -.04em; line-height: 1.2; margin: 12px 0 8px; font-variant-numeric: tabular-nums; }
  .runtime .rt-charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
  .runtime .rt-chart-panel { --rt-chart-color: var(--rt-accent); }
  .runtime [data-metric="cpu_percent"] { --rt-chart-color: var(--rt-cpu); }
  .runtime [data-metric="rss_bytes"] { --rt-chart-color: var(--rt-memory); }
  .runtime [data-metric="p95_ms"] { --rt-chart-color: var(--rt-latency); }
  .runtime .rt-chart-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .runtime .rt-chart-heading h2 { margin: 0; }
  .runtime .rt-chart-heading h2::before { content: ""; display: inline-block; width: 6px; height: 6px; background: var(--rt-chart-color); border-radius: 50%; margin: 0 8px 2px 0; }
  .runtime [data-chart-value] { color: var(--rt-chart-color); font-size: 24px; font-weight: 600; letter-spacing: -.025em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .runtime .rt-chart { width: 100%; height: 120px; overflow: visible; margin: 12px 0 8px; display: block; }
  .runtime .rt-chart polyline { stroke: var(--rt-chart-color); stroke-width: 2; fill: none; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .runtime .rt-chart line { stroke: var(--rt-line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .runtime .rt-chart line:not(:last-of-type) { stroke-dasharray: 3 5; }
  .runtime .rt-chart-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: var(--rt-muted); }
  .runtime .rt-chart-meta span:last-child { white-space: nowrap; }
  .runtime .rt-section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 4px 0 12px; }
  .runtime .rt-section-heading h2 { margin: 0; font-size: 16px; }
  .runtime .rt-details { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .runtime dl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, auto); margin: 0; gap: 0 16px; font-size: 13px; }
  .runtime dt, .runtime dd { padding: 10px 0; border-bottom: 1px solid var(--rt-line); }
  .runtime dt { color: var(--rt-muted); } .runtime dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .runtime .rt-table-scroll { overflow-x: auto; scrollbar-color: var(--rt-line) transparent; }
  .runtime table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .runtime th { color: var(--rt-muted); text-align: left; font-weight: 500; padding: 12px 10px 12px 0; }
  .runtime td { border-top: 1px solid var(--rt-line); padding: 12px 10px 12px 0; font-variant-numeric: tabular-nums; }
  .runtime td:nth-child(n+3), .runtime th:nth-child(n+3) { text-align: right; }
  .runtime tbody tr:hover { background: color-mix(in srgb, var(--rt-accent) 4%, transparent); }
  .runtime .rt-route { font-family: ui-monospace, monospace; white-space: nowrap; }
  .runtime .rt-error { color: var(--color-negative); }
  .runtime footer { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--rt-line); max-width: 90ch; }
  @media (prefers-color-scheme: dark) { .runtime { --rt-green: #74c6a0; --rt-cpu: #68c9bb; --rt-memory: #b6a0e3; --rt-latency: #e3b76c; } }
  @media (max-width: 900px) { .runtime { padding-inline: 24px; } .runtime .rt-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .runtime .rt-proof-grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .runtime { padding: 20px 16px 48px; } .runtime header { flex-wrap: wrap; gap: 16px; } .runtime .rt-logo { width: 44px; height: 44px; } .runtime .rt-identity { gap: 12px; } .runtime .rt-panel { padding: 16px; } .runtime .rt-proof { padding: 0; } .runtime .rt-proof summary, .runtime .rt-proof-grid { padding: 16px; } .runtime .rt-cards { gap: 12px; } .runtime .rt-value { font-size: 28px; } .runtime .rt-charts, .runtime .rt-details { grid-template-columns: 1fr; } .runtime .rt-section-heading { display: block; } }
</style>
<% end %>
<section class="runtime" data-controller="runtime-stats" data-runtime-stats-url-value="/runtime/stats">
  <header>
    <div class="rt-identity"><%= image_tag fresh_account_logo_path, alt: "Deccan Queen on Rails", size: 56, class: "rt-logo" %>
      <div><p class="rt-eyebrow">Deccan Queen on Rails · Campfire</p><h1>Live performance</h1><p class="rt-muted">Requests, resources and the native runtime. All in one place.</p></div></div>
    <div class="rt-actions"><%= link_to "← Back to chat", "/", class: "rt-back" %><span class="rt-live" data-field="live" role="status">Connecting…</span></div>
  </header>
  <details class="rt-panel rt-proof">
    <summary><strong data-field="proof">Waiting for telemetry</strong><span>Spinel / Roundhouse</span><span class="rt-disclosure">Build evidence</span></summary>
    <div class="rt-proof-grid">
      <div><small>Executable inspection</small><strong data-field="proof">Waiting for telemetry</strong><code data-field="executable">Unavailable</code></div>
      <div><small>Ruby runtime / process maps</small><strong data-field="ruby">Unavailable</strong><code data-field="container">Container unavailable</code></div>
      <div><small>Deployed artifact</small><strong data-field="image">Unavailable</strong><code data-field="revision">Revision unavailable</code><code data-field="digest">Digest unavailable</code></div>
    </div>
  </details>
  <div class="rt-cards">
    <div class="rt-panel"><small>Requests observed</small><span class="rt-value" data-field="total">—</span><small data-field="observed">Collector lifetime</small></div>
    <div class="rt-panel"><small>Throughput</small><span class="rt-value" data-field="rate">—</span><small>requests / second</small></div>
    <div class="rt-panel"><small>p95 handler latency</small><span class="rt-value" data-field="p95">—</span><small>last 60 seconds · recorded events</small></div>
    <div class="rt-panel"><small>Server errors</small><span class="rt-value" data-field="errors">—</span><small data-field="errorRate">HTTP 5xx</small></div>
  </div>
  <div class="rt-section-heading"><h2>Resource &amp; request trends</h2><span class="rt-muted">Retained sampling window · updated every 5s</span></div>
  <div class="rt-charts">
    <% [["cpu_percent", "CPU usage", "One full core = 100%"], ["rss_bytes", "Resident memory", "Sum of process RSS"], ["rate_per_second", "Request throughput", "Completed HTTP requests / second"], ["p95_ms", "Handler latency · p95", "60-second event window"]].each do |key, title, description| %>
      <div class="rt-panel rt-chart-panel" data-metric="<%= key %>"><div class="rt-chart-heading"><h2><%= title %></h2><strong data-chart-value="<%= key %>">—</strong></div><p class="rt-muted"><%= description %></p><svg class="rt-chart" data-chart="<%= key %>" viewBox="0 0 600 150" preserveAspectRatio="none" role="img" aria-label="<%= title %> over the retained sampling window"><line x1="0" y1="15" x2="600" y2="15"></line><line x1="0" y1="77" x2="600" y2="77"></line><line x1="0" y1="140" x2="600" y2="140"></line><g></g></svg><div class="rt-chart-meta"><span data-field="historyStart">Waiting for samples</span><span>Now · Peak <span data-chart-peak="<%= key %>">—</span></span></div></div>
    <% end %>
  </div>
  <div class="rt-section-heading"><h2>Host &amp; HTTP details</h2><span class="rt-muted">Measured on the running service</span></div>
  <div class="rt-details">
    <div class="rt-panel"><h2>Process &amp; storage</h2><dl>
      <% [["uptime", "Container uptime"], ["restarts", "Container restarts"], ["workers", "Native processes / threads"], ["fds", "Open file descriptors"], ["connections", "Established TCP connections"], ["memory", "Cgroup memory / limit"], ["cpuLimit", "CPU allocation"], ["hostCPU", "Host CPU usage"], ["hostLoad", "Host load · 1 / 5 / 15 min"], ["hostMemory", "Host memory used / total"], ["database", "Database footprint"], ["records", "Users / rooms / messages"]].each do |key, title| %><dt><%= title %></dt><dd data-field="<%= key %>">—</dd><% end %>
    </dl></div>
    <div class="rt-panel"><h2>HTTP status breakdown</h2><div class="rt-table-scroll"><table><thead><tr><th>Status</th><th>Meaning</th><th>Requests</th><th>Share</th></tr></thead><tbody data-runtime-stats-target="statuses"><tr><td colspan="4">Waiting for request events</td></tr></tbody></table></div></div>
  </div>
  <div class="rt-panel"><div class="rt-section-heading"><h2>Recent requests</h2><span class="rt-muted">Latest 50</span></div><p class="rt-muted">Normalized routes. No query strings or user content.</p><div class="rt-table-scroll" style="margin-top:12px"><table><thead><tr><th>Time</th><th>Method / route</th><th>Status</th><th>Duration</th><th>Body bytes</th></tr></thead><tbody data-runtime-stats-target="recent"><tr><td colspan="5">Waiting for request events</td></tr></tbody></table></div></div>
  <footer class="rt-muted"><span data-field="updated" role="status">Waiting for collector</span><br>Private to signed-in members. Refreshes every 5 seconds. Charts retain up to one hour; Prometheus stores 14 days. CPU and memory are host measurements, latency measures native handler execution and excludes network/TLS time. Bytes count response bodies; WebSocket frames are excluded.</footer>
</section>
