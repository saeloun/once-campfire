<% @page_title = @talk.title %>
<section class="talk-pilot" data-controller="talk-pilot" data-talk-pilot-snapshot-value="<%= room_talk_snapshot_path(@room) %>" data-talk-pilot-vote-value="<%= room_talk_vote_path(@room) %>" data-talk-pilot-moderate-value="<%= room_talk_moderate_path(@room) %>" data-talk-pilot-moderator-value="<%= Current.user.administrator? %>">
  <p class="talk-eyebrow">Deccan Queen on Rails · Talk questions</p>
  <h1><%= @talk.title %></h1>
  <p><%= @talk.speaker %> · <%= @talk.starts_at.in_time_zone("Asia/Kolkata").strftime("%d %b, %H:%M") %> IST</p>
  <p>In the <%= link_to "live talk channel", room_path(@room), target: "_blank", rel: "noopener" %>, send <strong>/ask your question</strong>. Questions stay open during Q&amp;A. Channel messages and questions may appear on the conference screen; keep personal details out.</p>
  <p data-talk-pilot-target="status" role="status">Connecting to the question queue…</p>
  <% if Current.user.administrator? %>
    <%= link_to "Open stage pilot", room_talk_stage_path(@room), target: "_blank", rel: "noopener", class: "btn" %>
    <div class="talk-controls" aria-label="Projection controls">
      <% { "chat" => "Live chat", "questions" => "Start Q&A", "advance" => "Next question", "paused" => "Pause screen", "blank" => "Blank screen", "live" => "Resume screen" }.each do |command, label| %>
        <button type="button" data-action="talk-pilot#moderate" data-command="<%= command %>"><%= label %></button>
      <% end %>
    </div>
  <% end %>
  <% if Current.user.administrator? %>
    <ol class="talk-stage-messages" data-talk-pilot-target="messages" aria-label="Stage chat moderation"></ol>
  <% end %>
  <ol class="talk-questions" data-talk-pilot-target="questions" aria-label="Talk questions"></ol>
  <p data-talk-pilot-target="empty" hidden>No questions yet. Start with /ask in the live channel.</p>
</section>
