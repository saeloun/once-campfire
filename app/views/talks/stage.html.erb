<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Talk stage · Campfire</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= current_user_meta_tags %>
    <%= script_aware_action_cable_meta_tag %>
    <%= stylesheet_link_tag :all %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="talk-stage"><main><section class="talk-pilot" data-controller="talk-pilot" data-talk-pilot-snapshot-value="<%= room_talk_snapshot_path(@room, stage: "true") %>" data-talk-pilot-stage-value="true">
  <header><p class="talk-eyebrow">Deccan Queen on Rails · Live talk channel</p><h1><%= @talk.title %></h1><p><%= @talk.speaker %></p></header>
  <p data-talk-pilot-target="status" role="status">Connecting to the stage pilot…</p>
  <ol class="talk-stage-messages" data-talk-pilot-target="messages" aria-label="Live talk messages"></ol>
  <ol class="talk-questions" data-talk-pilot-target="questions" aria-label="Live talk questions"></ol>
  <p data-talk-pilot-target="empty" hidden>Join the talk channel. Send /ask to collect a question for Q&amp;A.</p>
  <footer><p>Join this talk · <%= request.base_url %><%= room_path(@room) %></p><p>Questions stay open during Q&amp;A · /ask your question</p></footer>
</section>
</main></body>
</html>
