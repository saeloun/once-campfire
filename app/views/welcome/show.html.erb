<% @page_title = "No rooms yet" %>
<% @body_class = "sidebar" %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area">
  <div class="message-area--empty dq-empty min-width center">
    <figure class="center pad">
      <%= image_tag "deccan-queen/deccan-logo.png", alt: "Deccan Queen on Rails", width: 664, height: 664, class: "dq-empty__logo" %>
      <span class="for-screen-reader"><%= Current.user.name %></span>
    </figure>
    <h1>Welcome aboard</h1>
    <p>Choose a room from the menu to start a conversation.</p>
  </div>
</div>
